# Server-only. Do not prefix with VITE_ — that would expose values to the browser bundle.
# Copy this file to .env and fill in locally. Never commit .env.

# Required to proxy attended setlists. Get a key at https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=

# Your setlist.fm username (the public profile slug, not the key)
SETLISTFM_USER_ID=

# MusicBrainz requires a descriptive User-Agent (app + contact). No API key.
# https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting
MUSICBRAINZ_USER_AGENT=music.dougkarda.com/0.1 (https://music.dougkarda.com)
